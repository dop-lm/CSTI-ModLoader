<Window x:Class="ModLoader_Next安装包.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ModLoader_Next安装包"
        xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="850" d:DataContext="{d:DesignInstance local:MainWindow}">
    <hc:SimpleStackPanel Orientation="Vertical">
        <hc:RelativePanel HorizontalAlignment="Center" Height="320" Margin="16" Width="800">
            <hc:DashedBorder BorderThickness="1" BorderBrush="Aqua"
                             Margin="20" hc:RelativePanel.AlignLeftWithPanel="True"
                             hc:RelativePanel.AlignBottomWithPanel="True">
                <TextBlock Name="Tooltip" FontSize="26" TextWrapping="Wrap" Width="220">
                    如果下方的路径不正确,请手动在下方输入游戏路径(包含Card Survival - Fantasy Forest.exe文件)
                </TextBlock>
            </hc:DashedBorder>
            <Image Source="CIML_1.ico" Width="300" hc:RelativePanel.AlignHorizontalCenterWithPanel="True" />
            <hc:DashedBorder Margin="16" hc:RelativePanel.AlignRightWithPanel="True" Name="ResultBorder">
                <TextBlock Name="RunResult" FontSize="24" TextWrapping="Wrap" Width="220" />
            </hc:DashedBorder>
        </hc:RelativePanel>
        <TextBox Name="GamePath" TextAlignment="Center" FontSize="28" Text="GamePath" />
        <Button Height="56" PreviewMouseDown="UIElement_OnMouseDown">
            <TextBlock Text="安装" FontSize="32" TextAlignment="Center" />
        </Button>
        <hc:DashedBorder></hc:DashedBorder>
    </hc:SimpleStackPanel>
</Window>